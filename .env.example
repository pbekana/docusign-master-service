# =============================================================================
# DocuSign Master Service — Environment Variable Reference
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Deployment environment: development | staging | production
APP_ENV=development

# HTTP listen port
PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Full PostgreSQL connection URL
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://docusign:secret@localhost:5432/docusign_master?sslmode=disable

# Maximum number of connections in the pool
DB_MAX_CONNS=10

# Minimum number of idle connections kept in the pool
DB_MIN_CONNS=2

# ---------------------------------------------------------------------------
# DocuSign — OAuth / JWT Grant
# ---------------------------------------------------------------------------

# Integration key (client ID) from the DocuSign developer console
DOCUSIGN_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# DocuSign user ID (GUID) that will be impersonated
DOCUSIGN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the RSA private key file (.pem) generated in DocuSign developer console
DOCUSIGN_PRIVATE_KEY_PATH=/run/secrets/docusign_private.pem

# DocuSign OAuth authorization server hostname
# Sandbox: account-d.docusign.com  |  Production: account.docusign.com
DOCUSIGN_AUTH_SERVER=account-d.docusign.com

# OAuth scopes (space-separated)
DOCUSIGN_OAUTH_SCOPES=signature impersonation

# DocuSign account ID (GUID). If blank the service resolves it automatically.
DOCUSIGN_ACCOUNT_ID=

# DocuSign eSignature REST API base URI. If blank the service resolves it.
# Example: https://demo.docusign.net/restapi
DOCUSIGN_API_BASE_URI=

# Request timeout for DocuSign API calls (seconds)
DOCUSIGN_REQUEST_TIMEOUT_SECONDS=30

# Number of envelope records per page fetched from DocuSign
DOCUSIGN_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Maximum total time (seconds) to wait across all retries for a rate-limited request
RATE_LIMIT_MAX_WAIT_SECONDS=300

# Fallback wait time (seconds) when the Retry-After header is absent
RATE_LIMIT_FALLBACK_DELAY_SECONDS=60

# ---------------------------------------------------------------------------
# Retry policy
# ---------------------------------------------------------------------------

# Maximum number of retry attempts for transient failures
RETRY_MAX_ATTEMPTS=5

# Base delay (milliseconds) for exponential backoff
RETRY_BASE_DELAY_MS=500

# Maximum delay (milliseconds) between retries
RETRY_MAX_DELAY_MS=30000

# ---------------------------------------------------------------------------
# MinIO object storage
# ---------------------------------------------------------------------------

# MinIO server endpoint (host:port)
MINIO_ENDPOINT=localhost:9000

# MinIO access key (username)
MINIO_ACCESS_KEY=minioadmin

# MinIO secret key (password)
MINIO_SECRET_KEY=minioadmin

# Bucket name where output files are stored
MINIO_BUCKET_NAME=docusign-output

# Use TLS when connecting to MinIO
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# HMAC request signing
# ---------------------------------------------------------------------------

# Primary HMAC secret key used to verify inbound API requests.
# Value must be a hex-encoded 32-byte (256-bit) secret.
HMAC_SECRET_KEY_CORE=change-me-to-a-32-byte-hex-secret-value

# Allowed window (seconds) around the request timestamp before it is rejected
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Job worker
# ---------------------------------------------------------------------------

# Maximum number of extraction jobs that may run concurrently
MAX_CONCURRENT_JOBS=3

# Maximum parallel DocuSign API requests per running job
MAX_CONCURRENT_DOCUSIGN_REQUESTS=5

# How often (seconds) a running job updates its heartbeat row in the database
HEARTBEAT_INTERVAL_SECONDS=30

# Time (minutes) after the last heartbeat before a job is considered crashed
CRASH_TIMEOUT_MINUTES=10

# ---------------------------------------------------------------------------
# Local output (used when MinIO is disabled or for debugging)
# ---------------------------------------------------------------------------

# Directory where the service writes local Parquet / JSON output files
LOCAL_OUTPUT_DIR=/tmp/docusign-output
